APP_NAME=skeleton
APP_ENV=production
SCAN_CACHEABLE=false

DB_DRIVER=mysql
DB_READ_HOST=mysql_83
DB_WRITE_HOST=mysql_83
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=unimestre
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=redis
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0

ACL_DEBUG_ROUTES=false

# Ver config/autoload/swagger.php: por padrão fica desligado de propósito -- só
# ligue SWAGGER_ENABLE_SERVER se quiser subir o servidor HTTP dedicado do
# hyperf/swagger (porta 9500, não exposta no docker-compose.yml). O fluxo normal é
# gerar o JSON estático com `php bin/hyperf.php gen:swagger` e servir via container
# lumina-docs (porta 8082).
SWAGGER_ENABLE_SERVER=false
SWAGGER_URL_PATH=/swagger
APP_VERSION=1.0.0